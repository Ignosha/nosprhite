{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "What the village window may do. Network access is limited to the hosts listed here.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "store:default",
    {
      "identifier": "http:default",
      "allow": [
        { "url": "http://localhost:11434/*" },
        { "url": "http://127.0.0.1:11434/*" },
        { "url": "https://models.github.ai/*" },
        { "url": "https://api.github.com/*" },
        { "url": "https://api.stripe.com/*" },
        { "url": "https://www.noshashi.app/*" }
      ]
    }
  ]
}
