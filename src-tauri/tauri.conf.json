{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Nosprhite",
  "version": "0.1.2",
  "identifier": "app.nosprhite",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1430",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Nosprhite",
        "width": 1180,
        "height": 780,
        "minWidth": 900,
        "minHeight": 620
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEJBODJBQkIwNjJFNkQ5NDMKUldSRDJlWmlzS3VDdWpvOGYydzNZT1EwME9VYWpldDVFSTZORFJ4NXhQU3J2cXlMcUptWURZVkkK",
      "endpoints": [
        "https://github.com/Ignosha/nosprhite/releases/latest/download/latest.json"
      ]
    }
  }
}
